

@model LoginVM



<h1>Login</h1>
<div class="row">
    <div class=" form-group" style="text-align:center;margin:auto;width:50%;">
        <section>
            <form id="account" method="post">
                <h2>Use a local account to log in.</h2>
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="UserNameOrEmail"></label>
                    <input asp-for="UserNameOrEmail" class="form-control" aria-required="true" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" aria-required="true" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Login</button>

            </form>
        </section>
    </div>

</div>


